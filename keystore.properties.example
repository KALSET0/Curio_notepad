# Release signing configuration. Copy to keystore.properties and fill in.
# keystore.properties is git-ignored: passwords must never be committed.
# Generate the keystore once (keep the file + passwords backed up privately;
# losing them means updates to the published app can never be signed again):
#
#   keytool -genkeypair -v -keystore curio-release.jks -alias curio \
#     -keyalg RSA -keysize 2048 -validity 9125
#
storeFile=curio-release.jks
storePassword=CHANGE_ME
keyAlias=curio
keyPassword=CHANGE_ME
