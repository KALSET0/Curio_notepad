<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Cleartext HTTP is allowed only for the local Ollama server on your
         own Wi-Fi (Developer options). All cloud providers keep using HTTPS. -->
    <!-- Predictive back OFF on purpose: the gesture would scrub the pop
         transition interactively and look different from button navigation.
         With it off, system back plays the same slide as in-app buttons. -->
    <application
        android:name=".CurioApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/backup_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="true"
        android:enableOnBackInvokedCallback="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Curio">
        <!-- adjustNothing: the window never resizes for the keyboard; the chat
             composer tracks it with imePadding() only (no double offset). -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustNothing"
            android:theme="@style/Theme.Curio.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
