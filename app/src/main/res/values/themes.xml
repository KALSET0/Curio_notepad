<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Curio" parent="android:Theme.Material.Light.NoActionBar">
        <!-- Opaque black so screen transitions never flash white on the dark UI. -->
        <item name="android:windowBackground">@android:color/black</item>
    </style>

    <!-- System splash: instant branding while the app starts. The branded
         Compose screen (Splash route) takes over right after. -->
    <style name="Theme.Curio.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@android:color/black</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="windowSplashScreenAnimationDuration">1000</item>
        <item name="postSplashScreenTheme">@style/Theme.Curio</item>
    </style>
</resources>
